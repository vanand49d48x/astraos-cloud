{
  "name": "@astraos/mcp-server",
  "version": "0.1.0",
  "description": "ASTRA OS MCP Server — query satellite imagery directly from Claude Code",
  "bin": {
    "astra-os-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --banner:js '#!/usr/bin/env node'",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astra/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": ["mcp", "satellite", "earth-observation", "claude", "astra"]
}
